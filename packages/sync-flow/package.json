{
  "name": "@nikhilll/sync-flow",
  "version": "0.0.0",
  "description": "Offline-first data for React Native and Expo, with the sync logic done for you. JSI/C++ core via Nitro Modules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8bits-Nikk/sync-flow.git",
    "directory": "packages/sync-flow"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cpp",
    "!cpp/tests",
    "!cpp/third_party/**/*.md",
    "ios",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "nitrogen",
    "SyncFlow.podspec",
    "nitro.json",
    "app.plugin.js",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "!**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "codegen": "nitrogen --logLevel=info"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "devDependencies": {
    "nitrogen": "0.37.2",
    "react-native-nitro-modules": "0.37.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "@types/react": "19.3.0"
  }
}
