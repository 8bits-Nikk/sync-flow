{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["syncflow"],
  "ios": {
    "iosModuleName": "SyncFlow"
  },
  "android": {
    "androidNamespace": ["syncflow"],
    "androidCxxLibName": "SyncFlow"
  },
  "autolinking": {
    "SyncFlowCore": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridSyncFlowCore"
      }
    },
    "SyncFlowPlatform": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSyncFlowPlatform"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSyncFlowPlatform"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
